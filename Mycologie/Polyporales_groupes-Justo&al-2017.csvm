commentaire =;1 Regular round to angular pores;;;;;;;;;;;;;;;;;;;;;;;
commentaire =;2 Irregular, sinuous,  daedaleoid pores or lamellae;;;;;;;;;;;;;;;;;;;;;;;
commentaire =;3 Surface smooth or with small grains, rounded  projections, folds, wrinkles;;;;;;;;;;;;;;;;;;;;;;;
commentaire =;4  Surface with tooh-like  projections, aculei, rigid hairs, spine-like  structures;;;;;;;;;;;;;;;;;;;;;;;
commentaire =;" + indicates the character is common in the family, but not necessarily present in all species;";;;;;;;;;;;;;;;;;;;;;;;
commentaire =;(+) indicates the characters is present in only a few species;;;;;;;;;;;;;;;;;;;;;;;
